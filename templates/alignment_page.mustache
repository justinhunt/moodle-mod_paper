<div class="mod_paper_alignment_page">
    <p class="text-muted">
        {{#str}}scanalignmenthelp, mod_paper{{/str}}
    </p>
    <div class="alert alert-info">
        {{#str}}scanalignmentpadnote, mod_paper, {{croppadmm}}{{/str}}
    </div>

    <div class="row">
    <div class="col-lg-6">
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">{{#str}}alignmentdetect, mod_paper{{/str}}</h5>
            <p class="card-text text-muted small">{{#str}}alignmentdetecthelp, mod_paper{{/str}}</p>
            {{#candetect}}
                <a href="{{detecturl}}" class="btn btn-primary">{{#str}}alignmentdetectbutton, mod_paper{{/str}}</a>
            {{/candetect}}
            {{^candetect}}
                <div class="alert alert-info mb-0">{{#str}}alignmentdetectunavailable, mod_paper{{/str}}</div>
            {{/candetect}}

            {{#detection}}
                <table class="table table-sm mt-3 mb-0">
                    <thead>
                        <tr>
                            <th>{{#str}}alignmentaxis, mod_paper{{/str}}</th>
                            <th>{{#str}}alignmentmeasuredoffset, mod_paper{{/str}}</th>
                            <th>{{#str}}alignmentmeasuredscale, mod_paper{{/str}}</th>
                            <th>{{#str}}alignmentbands, mod_paper{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">{{#str}}alignmenthorizontal, mod_paper{{/str}}</th>
                            <td>{{offsetx}}</td>
                            <td>{{scalex}}</td>
                            <td>
                                <span class="text-muted">{{bandsx}}</span>
                                {{^reliablex}}
                                    <span class="badge badge-warning ml-1">{{#str}}alignmentunreliable, mod_paper{{/str}}</span>
                                {{/reliablex}}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">{{#str}}alignmentvertical, mod_paper{{/str}}</th>
                            <td>{{offsety}}</td>
                            <td>{{scaley}}</td>
                            <td>
                                <span class="text-muted">{{bandsy}}</span>
                                {{^reliabley}}
                                    <span class="badge badge-warning ml-1">{{#str}}alignmentunreliable, mod_paper{{/str}}</span>
                                {{/reliabley}}
                            </td>
                        </tr>
                    </tbody>
                </table>
                {{#anyunreliable}}
                    <div class="alert alert-warning mt-2 mb-0">
                        {{#str}}alignmentunreliablehelp, mod_paper{{/str}}
                    </div>
                {{/anyunreliable}}
            {{/detection}}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            {{{formhtml}}}
        </div>
    </div>

    <div class="mt-2 mb-3">
        <a href="{{reseturl}}" class="btn btn-secondary">{{#str}}alignmentresetbutton, mod_paper{{/str}}</a>
        <a href="{{returntoreportsurl}}" class="btn btn-secondary">{{#str}}returntoreports, mod_paper{{/str}}</a>
    </div>
    </div>

    <div class="col-lg-6">
        {{#hasevaluations}}
        <div class="card mb-3" style="position: sticky; top: 1rem;">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <span class="font-weight-bold mr-2">{{#str}}alignmentpreview, mod_paper{{/str}}</span>
                <div class="d-flex align-items-center">
                    <label class="sr-only" for="paper-preview-selector">{{#str}}alignmentpreviewstudent, mod_paper{{/str}}</label>
                    <select id="paper-preview-selector" class="form-control form-control-sm mr-2" style="width: auto;">
                        {{#previewoptions}}
                        <option value="{{value}}" data-url="{{url}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/previewoptions}}
                    </select>
                    <button type="button" id="paper-preview-reload" class="btn btn-secondary btn-sm text-nowrap">
                        {{#str}}alignmentpreviewreload, mod_paper{{/str}}
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <iframe id="paper-preview-frame" data-previewurl="{{previewurl}}"
                        title="{{#str}}alignmentpreview, mod_paper{{/str}}"
                        style="width: 100%; height: 75vh; border: 0;"></iframe>
            </div>
            <div class="card-footer text-muted small">
                {{#str}}alignmentpreviewhelp, mod_paper{{/str}}
            </div>
        </div>
        {{/hasevaluations}}
        {{^hasevaluations}}
        <div class="alert alert-secondary">{{#str}}alignmentpreviewnone, mod_paper{{/str}}</div>
        {{/hasevaluations}}
    </div>
    </div>
</div>
